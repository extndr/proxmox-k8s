# Local workflow configuration used by Make, Terraform, and Ansible.
PVE_SSH=root@192.168.0.122

TF_VAR_proxmox_endpoint=https://192.168.0.122:8006/
# Format: USER@REALM!TOKENID=SECRET
TF_VAR_proxmox_api_token=
TF_VAR_proxmox_insecure=true
TF_VAR_proxmox_node=pve
TF_VAR_template_vm_id=9000
TF_VAR_vm_datastore=local-lvm
# Existing Proxmox bridge/VNet. It must already provide connectivity to the
# vm_network_cidr/gateway configured in terraform/terraform.tfvars.
TF_VAR_network_bridge=vmbr0

# Ansible client-side SSH setting. Terraform never consumes the private key.
ANSIBLE_PRIVATE_KEY_FILE=~/.ssh/id_ed25519
